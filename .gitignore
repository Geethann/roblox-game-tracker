# Files Git should never save. Kept short and specific to this project
# (JavaScript + Cloudflare), so it can't accidentally hide real code.

# Downloaded libraries - recreated by `npm install` / `npm ci`
node_modules/

# Build output - recreated by `npm run build` / wrangler
dist/

# Cloudflare's local test database and cache (wrangler dev)
.wrangler/

# Secrets and local settings - never commit these
.env
.env.*
.dev.vars

# Logs and operating-system clutter
*.log
.DS_Store
Thumbs.db
