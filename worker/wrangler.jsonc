// Cloudflare settings for the backend.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "roblox-game-tracker",
	"main": "src/index.js",
	"compatibility_date": "2026-11-01",
	// Run scheduled() every 5 minutes.
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	// The database. "DB" is the name the code uses (env.DB).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "roblox-tracker",
			"database_id": "3cc4e0d6-fc36-4467-993b-1ca74ae883bf",
			"migrations_dir": "migrations"
		}
	],
	// Rate limits, counted per visitor (by IP address) and per Cloudflare location.
	// They're deliberately generous: many people can share one IP (a school, a
	// phone network), so these only catch scripts, not real visitors.
	"ratelimits": [
		{
			// Any API request: 300 a minute (normal browsing uses ~10-20).
			"name": "API_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 300, "period": 60 }
		},
		{
			// Adding a new game to the tracker: 10 a minute.
			"name": "TRACK_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"vars": {
		// Stay inside the free plan's database limits (100,000 writes a day, 500 MB).
		// Each game costs ~48 writes a day: 24 hourly rows saved + 24 old ones deleted.
		"MAX_TRACKED_GAMES": "1500"
	},
	// Keep logs so failed runs can be investigated in the Cloudflare dashboard.
	"observability": {
		"enabled": true
	}
}